# ===== PStock =====
APP_HOST=127.0.0.1
APP_PORT=8000
# Optional: set to require header X-API-Key on /api/* (dashboard shows a key box)
APP_API_KEY=

# ----- SSI (ssi-sdk / API v3, https://developers.ssi.com.vn/docs/sdk/python) -----
# Consumer ID / Secret are used as the SDK's api_key / api_secret. Market data needs no OTP.
SSI_CONSUMER_ID=your_ssi_consumer_id
SSI_CONSUMER_SECRET=your_ssi_consumer_secret
SSI_CLIENT_ID=
# Private key is only used for trading (orders). Not needed for market data.
SSI_PRIVATE_KEY=
SSI_API_URL=https://api.ssi.com.vn
SSI_STREAMING_URL=wss://stream.ssi.com.vn/ws/v3
SSI_RATE_LIMIT_PER_SECOND=10
# Realtime 1-minute bars over WebSocket (StreamingService) for the open chart
SSI_STREAM_ENABLED=true
SSI_LOG_LEVEL=WARNING

# ----- Data -----
# auto = Vietcap first, SSI fallback | vietcap | ssi | ssi_first = SSI first, Vietcap fallback
# (applies to every timeframe: 5m, 15m, 30m, 1h, 1D, 1W)
DATA_SOURCE=auto
# Cache TTL for 1D/1W (intraday timeframes refresh every 2-10 minutes)
CACHE_TTL_MINUTES=30
HISTORY_DAYS=500

# ----- Ichimoku Trịnh Phát -----
# trinhphat = Tenkan 9, Kijun 17, Chikou/dịch 26, Senkou B 33, Kijun dài 65 & 129 (Dao Găm)
# classic   = Tenkan 9, Kijun 26, Chikou/dịch 26, Senkou B 52, Kijun dài 129
# custom    = dùng các giá trị ICHI_TENKAN.. bên dưới
ICHI_PRESET=trinhphat
ICHI_TENKAN=9
ICHI_KIJUN=17
ICHI_SENKOU_B=33
ICHI_DISPLACEMENT=26
ICHI_LONG_KIJUN=65,129
# Các con số thời gian (Lý thuyết số học Ichimoku)
ICHI_TIME_CYCLES=9,17,26,33,42,65,76,129,172,200,257
ICHI_CYCLE_TOLERANCE=1
ICHI_PIVOT_LOOKBACK=129

# ----- Claude (Anthropic) - get a key at https://console.anthropic.com -----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=1500

# ----- Scanner watchlist (default: VN30) -----
WATCHLIST=ACB,BCM,BID,BVH,CTG,FPT,GAS,GVR,HDB,HPG,LPB,MBB,MSN,MWG,PLX,SAB,SHB,SSB,SSI,STB,TCB,TPB,VCB,VHM,VIB,VIC,VJC,VNM,VPB,VRE
