# Copy file này thành telegram.env rồi điền thông tin.
# Token của bot Telegram (lấy từ @BotFather)
TELEGRAM_BOT_TOKEN=
# Chat ID nhận tin (nhắn /start cho bot rồi chạy: .venv\Scripts\python scripts\telegram_chat_id.py)
# Nhiều chat: phân cách bằng dấu phẩy
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_EMPTY=true
# Trả lời lệnh /ck MãCK trong các chat ở TELEGRAM_CHAT_ID khi app đang chạy
TELEGRAM_COMMANDS=true
